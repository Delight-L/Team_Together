# 이 파일을 복사해 프로젝트 루트에 .env로 만들고 빈 값을 채웁니다.
# 실제 키를 넣은 .env는 올리지 않습니다. 하위 폴더에 따로 .env를 만들지 않고 이 파일 하나로 관리합니다.

# ── 공용 DB ─────────────────────────────────────────────
# 팀 공용 DB(Oracle Cloud): 관리자에게 받은 값을 넣습니다. 화면 조회만 하면 welfind_reader 계정을 사용합니다.
#   DB_HOST=<공용 IP>  DB_PORT=5432  DB_NAME=team_together  DB_USER=welfind_reader  DB_SSLMODE=require
# 로컬 DB로 개발할 때는 DB_HOST=127.0.0.1, DB_SSLMODE는 비워 둡니다.
DB_HOST=
DB_PORT=5432
DB_NAME=team_together
DB_USER=
DB_PASSWORD=
DB_SSLMODE=
# verify-full을 쓸 때만 서버 CA 인증서 경로를 지정합니다.
DB_SSLROOTCERT=
# 접속 대기 시간(초). 비우면 10초입니다.
DB_CONNECT_TIMEOUT=

# ── 자료 위치 ───────────────────────────────────────────
# 대시보드 분석 자료 위치: auto(DB 우선, 실패 시 로컬 CSV) | db(DB만) | csv(로컬 CSV만)
WELFIND_DATA_SOURCE=auto
# 보미 복지자료: db(기본, 공유 DB2 조회) | json(명시적인 오프라인 검증용)
# 첫 DB 적재: python -m backend.db.welfare_chatbot_repository import-json
WELFIND_WELFARE_SOURCE=db
# DB1 원천자료 기준 폴더. 비워두면 현재 저장소를 사용합니다.
TEAM_TOGETHER_DATA_ROOT=
# 분석·전처리가 읽고 쓰는 PostgreSQL 전용 스키마
DB1_PIPELINE_SCHEMA=db1_pipeline

# ── 보미 챗봇·보고서 외부 AI(선택) ─────────────────────
# 사용 여부와 제공사는 관리자 «AI 설정»에서 고르며 기본은 꺼짐입니다.
# 비워두면 데이터 근거 안내와 로컬 복지자료 검색으로 답합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# true이면 유해 콘텐츠 검사 API 장애·키 누락 때 v16 질문을 차단합니다(운영 권장 true, 로컬 확인은 false).
MODERATION_REQUIRED=false
# 사용자별 보미 질문 수 제한. 비우면 1분 20회, 하루 300회입니다.
WELFIND_CHAT_PER_MINUTE=
WELFIND_CHAT_PER_DAY=

# ── 공공데이터 API ──────────────────────────────────────
DATA_API_KEY=
# Service2에서는 기능명 끝에도 2가 붙습니다.
# HTTP 400/API 코드 12가 발생하면 신청 상세 화면의 전체 요청주소와 대조하세요.
DATA_API_ENDPOINT=https://apis.data.go.kr/B554287/sclWlfrFcltInfoInqirService2
DATA_API_OPERATION=getFcltByBassInfoInqire2

# DB2 지자체복지서비스 (15108347) 활용신청을 승인받은 키.
# 비워두면 기존 DATA_API_KEY 사용. 다른 데이터셋 endpoint 설정과 독립적입니다.
DB2_WELFARE_API_KEY=
DB2_WELFARE_DAILY_BUDGET=900
# 둘 다 비우면 전국. 특정 지역 수집 시 공식 API 지역명을 입력합니다.
DB2_WELFARE_PROVINCE=
DB2_WELFARE_DISTRICT=

# SGIS(통계지리정보) API
consumer_key=
consumer_secret=
