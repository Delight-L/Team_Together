# SGIS API credentials
# Copy this file to .env and replace the blank values locally.
# Never commit the populated .env file.
consumer_key=
consumer_secret=

#DB 접속 키
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 지자체복지서비스 API 인증키 (디코딩 키)
DATA_API_KEY=
# 파일데이터 API 키. 해당 데이터셋 활용신청 후 설정합니다.
# 비어 있으면 DATA_API_KEY를 사용합니다.
ODCLOUD_API_KEY=

# 선택 사항: 실제 분석 근거 기반 AI 질의 설명 (미설정 시 규칙 기반 설명)
GEMINI_API_KEY=
GEMINI_MODEL=
