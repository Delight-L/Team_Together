# SGIS API credentials
# Copy this file to .env and replace the blank values locally.
# Never commit the populated .env file.
consumer_key=
consumer_secret=

#DB 접속 키
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

#공공데이터 api 키
DATA_API_KEY=
# Service2에서는 기능명 끝에도 2가 붙습니다.
# HTTP 400/API 코드 12가 발생하면 신청 상세 화면의 전체 요청주소와 대조하세요.
DATA_API_ENDPOINT=https://apis.data.go.kr/B554287/sclWlfrFcltInfoInqirService2
DATA_API_OPERATION=getFcltByBassInfoInqire2

# DB2 지자체복지서비스 (15108347) 활용신청을 승인받은 키.
# 비워두면 기존 DATA_API_KEY 사용. 다른 데이터셋 endpoint 설정과 독립적입니다.
DB2_WELFARE_API_KEY=
DB2_WELFARE_DAILY_BUDGET=900
# 둘 다 비우면 전국. 특정 지역 수집 시 공식 API 지역명을 입력합니다.
DB2_WELFARE_PROVINCE=
DB2_WELFARE_DISTRICT=
