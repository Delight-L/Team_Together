# 저장소 전체의 무시 규칙은 이 파일 하나로 관리합니다. 하위 폴더에 .gitignore를 따로 만들지 마세요.

# ── 비밀 정보 ───────────────────────────────────────────
# .env는 올리지 않고 루트의 .env.example만 올립니다.
*.env
**/api_key.txt
**/.env.txt

# ── 설치물·빌드 결과·캐시 ───────────────────────────────
*.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
node_modules/
.pnpm-store/
frontend/dist/
.build/
.runtime-packages/

# ── 실행 중 생기는 파일 ─────────────────────────────────
*.log
*.tmp
.tmp/
# SQLite 작업 파일(본 DB 파일은 그대로 둡니다)
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
# 담당자 업무 기록 DB와 관리자 «AI 설정»(서버에만 보관)
backend/db/runtime/*.sqlite3*
backend/db/runtime/ai_settings.json
# v16 지역 분석 에이전트의 로컬 DB1 SQLite(약 100MB)는 따로 전달합니다. 위치는 DB1_DATABASE_PATH로 바꿀 수 있습니다.
backend/agents/regional_v16/outputs/*.sqlite
backend/agents/regional_v16/outputs/*.sqlite-*
backend/agents/regional_v16/outputs/runtime/
# DB1 파이프라인의 실행 상태·로컬 설정·백업
pipelines/db1/outputs/runtime/
pipelines/db1/outputs/backups/
pipelines/db1/config/db1_config.local.json
# 검토용 스크린샷·화면 검증 산출물(로컬 보관)
output/
artifacts/

# ── 다시 만들 수 있는 실행 보고서 ───────────────────────
data/processed/group_dashboard.json
pipelines/regional_analysis/analysis2_execution_report.json
pipelines/preprocessing/**/outputs/*manifest.json
pipelines/preprocessing/**/outputs/**/preprocessing_manifest.json
pipelines/preprocessing/**/outputs/validation_report.json
# 예외: 과거 전처리 기록으로 남기는 보고서
!pipelines/preprocessing/regional_types/outputs/previous_preprocessing_agent/analysis1_preprocessed/preprocessing_manifest.json

# ── 데이터·문서 파일 ────────────────────────────────────
# 기본적으로 올리지 않고, 화면·분석·테스트에 필요한 파일만 아래에서 예외로 허용합니다.
*.csv
*.pdf
*.xlsx
*.jpg
*.txt
*.geojson
*.zip

# 예외: 의존성 목록
!requirements.txt
!pipelines/db1/requirements.txt

# 예외: 분석·위험도 자료
!pipelines/risk_analysis/data/gangnam_analysis1_cluster_profile_2025H2(1).csv
!pipelines/risk_analysis/data/gangnam_db1_dong_month_behavior_mart_2025_07_12(1).csv
!pipelines/risk_analysis/data/gangnam_db1_final_k2_cluster_result_2025(1).csv

# 예외: 지역 유형·지역 특성 전처리 자료
!pipelines/preprocessing/regional_features/reference/weather_monthly.csv
!pipelines/preprocessing/regional_types/outputs/analysis1_preprocessed/analysis1_input.csv
!pipelines/preprocessing/regional_types/raw_data/1인가구(거처종류별)_20260922163814.csv
!pipelines/preprocessing/regional_types/raw_data/1인가구(연령별)_20260923095001.csv
!pipelines/preprocessing/regional_types/raw_data/gangnam_db1_features_202507.csv
!pipelines/preprocessing/regional_types/raw_data/gangnam_db1_features_2025H2.csv
!pipelines/preprocessing/regional_types/raw_data/고령자현황(강남구 동별).csv
!pipelines/preprocessing/regional_types/raw_data/국민기초생활 수급자 동별 현황(202405).xlsx
!pipelines/preprocessing/regional_types/raw_data/국민기초생활보장+수급자(2020+이후)_20260922173232.csv
!pipelines/preprocessing/regional_types/raw_data/국민기초생활보장+연령별+일반수급자(구별)_20260922173516.csv
!pipelines/preprocessing/regional_types/raw_data/독거노인현황_2022_2025.csv
!pipelines/preprocessing/regional_types/raw_data/등록인구(연령별_동별)_20260922163622.csv
!pipelines/preprocessing/regional_types/raw_data/세대원수별+세대수_2025Q3_Q4.csv
!pipelines/preprocessing/regional_types/raw_data/장애인 현황(장애유형별, 동별).csv
!pipelines/preprocessing/regional_types/raw_data/장애인+현황(등급별_연령별)_20260923095357.csv
