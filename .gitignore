output/

# v16 지역 분석 에이전트의 DB1 SQLite(약 100MB)는 저장소에 올리지 않고 따로 전달합니다.
# 위치를 바꾸려면 DB1_DATABASE_PATH 환경 변수로 지정합니다.
backend/agents/regional_v16/outputs/*.sqlite
backend/agents/regional_v16/outputs/*.sqlite-*
backend/agents/regional_v16/outputs/runtime/
